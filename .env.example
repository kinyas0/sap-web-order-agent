# ---------------------------------------------------------------- SAP (required)
SAP_ASHOST=
SAP_SYSNR=
SAP_CLIENT=
SAP_USER=
SAP_PASSWORD=
SAP_LANG=EN

# Sales area the order is booked into.
SAP_DOC_TYPE=TA
SAP_SALES_ORG=0001
SAP_DISTR_CHAN=01
SAP_DIVISION=01

# Language key for MAKT descriptions. Without it the material lookup fuzzy-matches
# across every translation in the system.
SAP_MATERIAL_LANGUAGE=E

# Guard rails on master-data reads.
SAP_READ_ROW_LIMIT=20000
SAP_CACHE_TTL_SECONDS=900

# ------------------------------------------------------- language model (required)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=2

# ------------------------------------------------------------- audit trail (optional)
# Leave DB_HOST empty to run without one: orders are still created, nothing is logged.
# Schema: psql "$DATABASE_URL" -f db/schema.sql
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_POOL_MAX_SIZE=4
DB_CONNECT_TIMEOUT_SECONDS=5

# ---------------------------------------------------------------------- behaviour
MATCH_SCORE_THRESHOLD=80
LOG_LEVEL=INFO
